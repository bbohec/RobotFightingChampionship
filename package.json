{
  "name": "robotfightingchampionship",
  "version": "0.0.0",
  "description": "",
  "alias": {
    "uuid": "./node_modules/uuid/dist/esm-browser/index.js"
  },
  "scripts": {
    "build": "npm run clean:build && parcel build",
    "clean:build": "rimraf dist",
    "start": "node dist/main.js",
    "test": "mocha 'src/**/*.spec.ts'",
    "test-watch": "mocha 'src/**/*.spec.ts' --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src",
    "lint:fix": "biome check --write src"
  },
  "targets": {
    "frontend-test": {
      "context": "browser",
      "source": "src/public/html/test.html",
      "distDir": "dist/public",
      "sourceMap": true,
      "optimize": false,
      "scopeHoist": false
    },
    "frontend-production": {
      "context": "browser",
      "source": "src/public/html/game.html",
      "distDir": "dist/public",
      "sourceMap": true,
      "optimize": false,
      "scopeHoist": false
    },
    "backend": {
      "context": "node",
      "source": "src/main.ts",
      "distDir": "dist",
      "outputFormat": "commonjs",
      "optimize": false,
      "scopeHoist": false
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bbohec/RobotFightingChampionship.git"
  },
  "author": "",
  "license": "AGPL-3.0-only",
  "bugs": {
    "url": "https://github.com/bbohec/RobotFightingChampionship/issues"
  },
  "homepage": "https://github.com/bbohec/RobotFightingChampionship#readme",
  "mocha": {
    "reporter": "spec",
    "full-trace": true,
    "import": "tsx"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@swc/core": "^1.16.13",
    "@types/chai": "^5.2.3",
    "@types/deep-equal-in-any-order": "^1.0.4",
    "@types/express": "^5.0.6",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "axios": "^1.20.0",
    "chai": "^5.3.3",
    "deep-equal-in-any-order": "^2.2.0",
    "eventsource": "^5.1.2",
    "express": "^5.2.1",
    "globals": "^17.12.0",
    "log4js": "^6.9.1",
    "mocha": "^11.8.0",
    "parcel": "^2.16.4",
    "pixi.js": "^8.21.0",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "stream-browserify": "^3.0.0",
    "stream-http": "^3.2.0",
    "three": "^0.186.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "util": "^0.12.5",
    "uuid": "^14.0.2",
    "winston": "^3.19.0"
  }
}
