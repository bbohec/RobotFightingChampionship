{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node", "mocha"],
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "strict": true,
    "skipLibCheck": true
  }
}